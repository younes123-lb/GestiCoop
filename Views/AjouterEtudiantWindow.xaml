<Window x:Class="GestiCoop.Views.AjouterEtudiantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajouter un étudiant"
        Height="570" Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="65"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Border Background="#214E75">
            <Grid Margin="22,0">
                <TextBlock Text="Ajouter un étudiant"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Formulaire -->
        <StackPanel Grid.Row="1" Margin="24,20">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="NOM *"
                               Foreground="#78899F"
                               FontWeight="Bold"/>
                    <TextBox x:Name="txtNom"
                              Height="44"
                              Margin="0,7,0,0"
                              Padding="10"
                              Text="{Binding Nom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              TextChanged="VerifierChamps"/>

                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="PRÉNOM *"
                               Foreground="#78899F"
                               FontWeight="Bold"/>
                    <TextBox x:Name="txtPrenom"
                             Height="44"
                             Margin="0,7,0,0"
                             Padding="10"
                             TextChanged="VerifierChamps"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="COURRIEL *"
                       Margin="0,20,0,7"
                       Foreground="#78899F"
                       FontWeight="Bold"/>

            <TextBox x:Name="txtCourriel"
                     Height="44"
                     Padding="10"
                     TextChanged="txtCourriel_TextChanged"/>

            <TextBlock x:Name="txtErreur"
                       Text="⚠ Adresse courriel invalide — ex. : prenom.nom@etud.lacite.ca"
                       Foreground="#FF493D"
                       FontSize="12"
                       Margin="0,7,0,0"
                       Visibility="Collapsed"/>

            <TextBlock Text="PROGRAMME *"
                       Margin="0,20,0,7"
                       Foreground="#78899F"
                       FontWeight="Bold"/>

            <ComboBox x:Name="cmbProgramme"
                      Height="44"
                      Padding="10,5"
                      SelectionChanged="VerifierChamps">
                <ComboBoxItem Content="Informatique"/>
                <ComboBoxItem Content="Génie logiciel"/>
                <ComboBoxItem Content="Cybersécurité"/>
            </ComboBox>

            <TextBlock Text="NUMÉRO D'ÉTUDIANT"
                       Margin="0,20,0,7"
                       Foreground="#78899F"
                       FontWeight="Bold"/>

            <TextBox x:Name="txtNumero"
                     Height="44"
                     Padding="10"
                     TextChanged="VerifierChamps"/>

            <TextBlock Text="Format : 7 chiffres (ex. : 2024001)"
                       Foreground="#78899F"
                       FontSize="12"
                       Margin="0,7,0,0"/>

        </StackPanel>

        <!-- Boutons -->
        <Border Grid.Row="2"
                BorderBrush="#D0D8E2"
                BorderThickness="0,1,0,0">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="20,0">

                <Button Content="Annuler"
                         Width="90"
                         Height="35"
                         Margin="0,0,10,0"
                         Click="Annuler_Click"/>


                <Button x:Name="btnEnregistrer"
                         Content="Enregistrer"
                         Width="115"
                         Height="35"
                         Background="#EF9B93"
                         Foreground="White"
                         BorderThickness="0"
                        IsEnabled="False"
                        Click="Enregistrer_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>
